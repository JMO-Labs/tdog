{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdog/schema/terminal.schema.json",
  "title": "tdog terminal preset",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "cwd": {
      "type": "string"
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "persistent": {
      "type": "boolean"
    },
    "pre_exec": {
      "$ref": "#/$defs/hook"
    },
    "command": {
      "type": "string"
    },
    "post_exec": {
      "$ref": "#/$defs/hook"
    },
    "on_close": {
      "$ref": "#/$defs/hook"
    },
    "theme": {
      "type": "string"
    },
    "font": {
      "$ref": "#/$defs/font"
    },
    "background": {
      "$ref": "#/$defs/background"
    }
  },
  "$defs": {
    "font": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 6,
          "maximum": 72
        },
        "ligatures": {
          "type": "boolean"
        }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "none",
            "color",
            "image",
            "shader"
          ]
        },
        "ref": {
          "type": "string"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blur": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "hook": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run"
          ],
          "properties": {
            "mode": {
              "enum": [
                "all",
                "stop_on_fail"
              ]
            },
            "run": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "target": {
      "enum": [
        "ssh-host",
        "container",
        "nsenter"
      ]
    }
  }
}
