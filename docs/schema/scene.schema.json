{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdog/schema/scene.schema.json",
  "title": "tdog scene preset",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "autostart": {
      "type": "boolean"
    },
    "theme": {
      "type": "string"
    },
    "gap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "pane_opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "background": {
      "$ref": "#/$defs/background"
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "panes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "preset": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "override": {
            "type": "object",
            "description": "Terminal preset fields; see terminal.schema.json"
          }
        }
      }
    }
  },
  "$defs": {
    "layout": {
      "type": "object",
      "description": "Renderer-agnostic tree: split (dir, ratio, a, b) or pane (slot id from panes[].id)",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["pane", "split"] },
        "pane": { "type": "string" },
        "dir": { "enum": ["row", "col"] },
        "ratio": { "type": "number", "minimum": 0.1, "maximum": 0.9 },
        "a": { "$ref": "#/$defs/layout" },
        "b": { "$ref": "#/$defs/layout" }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 6,
          "maximum": 72
        },
        "ligatures": {
          "type": "boolean"
        }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "none",
            "color",
            "image",
            "shader",
            "gradient",
            "pattern",
            "video"
          ]
        },
        "ref": {
          "type": "string"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blur": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "hook": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run"
          ],
          "properties": {
            "mode": {
              "enum": [
                "all",
                "stop_on_fail"
              ]
            },
            "run": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "target": {
      "enum": [
        "ssh-host",
        "container",
        "nsenter"
      ]
    }
  }
}
